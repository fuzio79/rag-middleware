# Copy to .env and fill in. Never commit .env.

# --- authentication --------------------------------------------------------
# Shared API key. Every data endpoint requires it as the X-API-Key header.
# The service FAILS CLOSED: if this is empty and RAG_REQUIRE_AUTH is true,
# every data endpoint answers 503 rather than serving openly.
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
RAG_API_KEY=
# Leave true. Setting it to false serves every endpoint unauthenticated and is
# only appropriate on a trusted, non-routable network.
RAG_REQUIRE_AUTH=true

# FastAPI serves /docs, /redoc and /openapi.json itself, outside the routers, so
# they do not inherit the API key. They are gated by default. Set this to true
# only for local development: it advertises the ingest surface to anything that
# can reach the port.
RAG_PUBLIC_DOCS=false

# --- scraper credentials ---------------------------------------------------
# Must match the bearer token your crawl4ai instance runs with, otherwise
# /crawl answers 401 and engine=auto silently falls through to Firecrawl.
CRAWL4AI_API_TOKEN=
# Optional: Firecrawl is only the fallback scraper.
FIRECRAWL_API_KEY=

# --- crawl4ai endpoint -----------------------------------------------------
CRAWL_URL=http://crawl4ai:11235/crawl

# --- outbound safety -------------------------------------------------------
# Optional narrowing allowlist. Leave empty for the default public-only policy:
# any globally routable host may be crawled, while loopback, private,
# link-local and reserved ranges are refused. That is "anything that is not
# local", and it is the intended setting here.
#
# Setting this only NARROWS the set further; it is not what blocks private
# addresses. The control that does not depend on this service seeing the
# request is network egress policy on the crawl4ai container.
RAG_ALLOWED_CRAWL_DOMAINS=
# Max chunks embedded by a single request, across the page and every followed
# link. Bounds CPU work per call.
RAG_MAX_CHUNKS_PER_REQUEST=2000
# Cap on followed links per ingest.
RAG_MAX_FOLLOW_LINKS=30

# --- runtime ---------------------------------------------------------------
RAG_PORT=8000
RAG_IMAGE=rag-middleware:latest
RAG_CONTAINER_NAME=rag-service

# Host paths for the vector store and model cache.
# scripts/clean.sh defaults to ./data/knowledge_base, the same directory.
RAG_KB_PATH=./data/knowledge_base
RAG_HF_PATH=./data/hf_cache

# Must match the image's APP_UID/APP_GID build args.
RAG_UID=1000
RAG_GID=1000
